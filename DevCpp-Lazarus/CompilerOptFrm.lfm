        object cbNoasm: TCheckBox
          Left = 16
          Height = 19
          Top = 8
          Width = 342
          Caption = 'Do not recognize asm, inline or typeof as keyword [-fno-asm]'
          TabOrder = 0
        end
        object cbTradional: TCheckBox
          Left = 16
          Height = 19
          Top = 32
          Width = 294
          Caption = 'Imitate traditional C preprocessors [-traditional-cpp]'
          TabOrder = 1
        end
        object cbShadow: TCheckBox
          Left = 16
          Height = 19
          Top = 80
          Width = 356
          Caption = 'Warn whenever local object shadows other objects. [-Wshadow]'
          TabOrder = 2
        end
        object cbWfatal: TCheckBox
          Left = 16
          Height = 19
          Top = 200
          Width = 268
          Caption = 'Abort compilation on first error [-Wfatal-errors]'
          TabOrder = 3
        end
        object cbPipe: TCheckBox
          Left = 16
          Height = 19
          Top = 248
          Width = 324
          Caption = 'Use pipes instead of temporary files in compilation [-pipe]'
          TabOrder = 4
        end
        object cbStrip: TCheckBox
          Left = 16
          Height = 19
          Top = 272
          Width = 286
          Caption = 'Remove extra information from the executable [-s]'
          TabOrder = 5
        end
        object cbMaxerror: TCheckBox
          Left = 16
          Height = 19
          Top = 224
          Width = 310
          Caption = 'Abort compilation for errors up to 10 [-fmax-errors=10]'
          TabOrder = 6
        end
