        object cbFloatEqual: TCheckBox
          Left = 16
          Height = 19
          Top = 104
          Width = 350
          Caption = 'Warn if floating-point in equality comparisons. [-Wfloat-equal]'
          TabOrder = 8
        end
        object cbPedantic: TCheckBox
          Left = 16
          Height = 19
          Top = 56
          Width = 358
          Caption = 'Issue all the warnings demanded by strict ISO C/C++ [-pedantic]'
          TabOrder = 9
        end
        object cbUninitialized: TCheckBox
          Left = 16
          Height = 19
          Top = 128
          Width = 399
          Caption = 'Turn WARNING "Variable uninitialized" to ERROR [-Werror=uninitialized]'
          TabOrder = 10
        end
        object cbVLA: TCheckBox
          Left = 16
          Height = 19
          Top = 176
          Width = 328
          Caption = 'Report using variable-length array as ERROR. [-Werror=vla]'
          TabOrder = 11
        end
        object cbReturnType: TCheckBox
          Left = 16
          Height = 19
          Top = 152
          Width = 368
          Caption = 'Report no return type in function as ERROR. [-Werror=return-type]'
          TabOrder = 12
        end
      end
